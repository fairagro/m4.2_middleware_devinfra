# Shared product-app image base (issue #36 / C2).
#
# Stages: package-builder → binary-builder → export-binaries
# Runtime finishing (USER/CMD/HEALTHCHECK/…) belongs in the product-local last stage.
#
# Compose with Buildx Bake (A4): build a "*-base" target through export-binaries, then wire
# contexts so the last stage can `COPY --from=export_bins /dist/…`.
#
# ── ARGs (Bake / --build-arg; toolchain pins usually from versions.env) ─────────
# Toolchain (FROM-scoped — declare before first FROM):
#   PYTHON_VERSION   e.g. 3.12.14
#   ALPINE_MINOR     e.g. 3.24  (python image alpine tag major.minor)
#   PIP_VERSION      e.g. 26.2.1
#   UV_VERSION       e.g. 0.12.9
# Package build:
#   APP_VERSION           PEP 440 pretend version for setuptools-scm
#   UV_BUILD_PACKAGES     space-separated uv workspace package names to wheel
# Binary build:
#   BINARY_NAME             primary PyInstaller --name / onedir under dist/
#   PYINSTALLER_ENTRY       entry script path for PyInstaller
#   EXTRA_PYINSTALLER_ARGS  extra args appended to pyinstaller (word-split)
#   BUILDER_APK_PACKAGES    extra apk packages for binary-builder (space-separated)
#   ODBC_APK_URL            if non-empty, download .apk and place under /dist for last stage
#   BINARY_INSTALL_MODE     "system" (default: uv pip --system) or "sync" (uv sync + venv)
#
# Defaults keep FROM valid for empty CI build-args (BuildKit InvalidDefaultArgInFrom).

ARG PYTHON_VERSION=3.12
ARG ALPINE_MINOR=3.24
ARG PIP_VERSION=26.2.1
ARG UV_VERSION=0.12.9

# ── package-builder ───────────────────────────────────────────────────────────
FROM python:${PYTHON_VERSION}-alpine${ALPINE_MINOR} AS package-builder

ARG APP_VERSION=0.0.0
ARG PIP_VERSION=26.2.1
ARG UV_VERSION=0.12.9
ARG UV_BUILD_PACKAGES

ENV SETUPTOOLS_SCM_PRETEND_VERSION=${APP_VERSION}

WORKDIR /build

COPY pyproject.toml uv.lock ./
COPY middleware ./middleware

RUN pip install --no-cache-dir --upgrade \
    "pip==${PIP_VERSION}" \
    "uv==${UV_VERSION}"

# Build one wheel per package name in UV_BUILD_PACKAGES
RUN set -eu; \
    if [ -z "${UV_BUILD_PACKAGES:-}" ]; then \
      echo "ERROR: UV_BUILD_PACKAGES must list uv workspace package names" >&2; \
      exit 1; \
    fi; \
    for pkg in ${UV_BUILD_PACKAGES}; do \
      uv build --package "${pkg}" --wheel; \
    done

# ── binary-builder ────────────────────────────────────────────────────────────
ARG PYTHON_VERSION=3.12
ARG ALPINE_MINOR=3.24
ARG PIP_VERSION=26.2.1
ARG UV_VERSION=0.12.9

FROM python:${PYTHON_VERSION}-alpine${ALPINE_MINOR} AS binary-builder

ARG APP_VERSION=0.0.0
ARG PIP_VERSION=26.2.1
ARG UV_VERSION=0.12.9
ARG BINARY_NAME
ARG PYINSTALLER_ENTRY
ARG EXTRA_PYINSTALLER_ARGS=""
ARG BUILDER_APK_PACKAGES=""
ARG ODBC_APK_URL=""
ARG BINARY_INSTALL_MODE=system

ENV SETUPTOOLS_SCM_PRETEND_VERSION=${APP_VERSION}

# Pin versions in product overlays when adopting; shared base keeps a minimal compile toolchain.
# hadolint ignore=DL3018
RUN apk add --no-cache \
    build-base \
    libffi-dev \
    openssl-dev \
    cargo \
    musl-utils \
    libssl3 \
    curl \
    ${BUILDER_APK_PACKAGES}

WORKDIR /build

RUN pip install --no-cache-dir --upgrade \
    "pip==${PIP_VERSION}" \
    "uv==${UV_VERSION}"

# Optional Microsoft ODBC driver apk (sql-to-arc); skipped when ODBC_APK_URL is empty
RUN set -eu; \
    if [ -n "${ODBC_APK_URL}" ]; then \
      curl -fsSL -o /tmp/msodbcsql.apk "${ODBC_APK_URL}"; \
    fi

COPY --from=package-builder /build/dist/*.whl /tmp/wheels/

COPY pyproject.toml uv.lock ./
COPY middleware ./middleware

RUN set -eu; \
    case "${BINARY_INSTALL_MODE}" in \
      system) \
        uv pip install --system /tmp/wheels/*.whl; \
        uv pip install --system pyinstaller; \
        ;; \
      sync) \
        uv sync --no-dev --no-install-workspace; \
        uv pip install /tmp/wheels/*.whl pyinstaller; \
        ;; \
      *) \
        echo "ERROR: BINARY_INSTALL_MODE must be system or sync (got: ${BINARY_INSTALL_MODE})" >&2; \
        exit 1; \
        ;; \
    esac

RUN set -eu; \
    if [ -z "${BINARY_NAME:-}" ] || [ -z "${PYINSTALLER_ENTRY:-}" ]; then \
      echo "ERROR: BINARY_NAME and PYINSTALLER_ENTRY are required" >&2; \
      exit 1; \
    fi; \
    if [ "${BINARY_INSTALL_MODE}" = "sync" ]; then \
      # shellcheck disable=SC2086
      .venv/bin/python -m PyInstaller --onedir \
        --name "${BINARY_NAME}" \
        ${EXTRA_PYINSTALLER_ARGS} \
        "${PYINSTALLER_ENTRY}"; \
    else \
      # shellcheck disable=SC2086
      pyinstaller --onedir \
        --name "${BINARY_NAME}" \
        ${EXTRA_PYINSTALLER_ARGS} \
        "${PYINSTALLER_ENTRY}"; \
    fi; \
    if [ -f /tmp/msodbcsql.apk ]; then \
      cp /tmp/msodbcsql.apk /build/dist/msodbcsql.apk; \
    fi

# ── export-binaries (Bake context payload) ────────────────────────────────────
FROM scratch AS export-binaries

COPY --from=binary-builder /build/dist /dist
