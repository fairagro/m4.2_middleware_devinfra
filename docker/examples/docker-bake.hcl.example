# Example Buildx Bake file for A4 (base + last). Copy to product repo root as docker-bake.hcl
# and adjust component names / ARGs. reusable-build expects a repo-root docker-bake.hcl whose
# target name equals the workflow `components` matrix entry (e.g. "api").
#
#   docker buildx bake api --load
#
# Contexts: last stage Dockerfile uses `FROM`/`COPY --from=export_bins` where `export_bins`
# is wired to `target:<component>-base`.

variable "APP_VERSION" {
  default = "0.0.0"
}

variable "PYTHON_VERSION" {
  default = "3.12.14"
}

variable "ALPINE_VERSION" {
  default = "3.24.1"
}

variable "ALPINE_MINOR" {
  default = "3.24"
}

variable "PIP_VERSION" {
  default = "26.2.1"
}

variable "UV_VERSION" {
  default = "0.12.9"
}

variable "IMAGE_TAG" {
  default = "local/example-api:dev"
}

target "api-base" {
  context    = "."
  dockerfile = "docker/Dockerfile.product-app.base"
  target     = "export-binaries"
  args = {
    APP_VERSION        = APP_VERSION
    PYTHON_VERSION     = PYTHON_VERSION
    ALPINE_MINOR       = ALPINE_MINOR
    PIP_VERSION        = PIP_VERSION
    UV_VERSION         = UV_VERSION
    UV_BUILD_PACKAGES  = "fairagro-middleware-shared api"
    BINARY_NAME        = "middleware-api"
    PYINSTALLER_ENTRY  = "placeholder-set-me.py"
    BINARY_INSTALL_MODE = "system"
  }
}

target "api" {
  context    = "."
  dockerfile = "docker/examples/Dockerfile.last.example"
  contexts = {
    export_bins = "target:api-base"
  }
  args = {
    ALPINE_VERSION  = ALPINE_VERSION
    BINARY_NAME     = "middleware-api"
    RUNTIME_USER    = "middleware"
    RUNTIME_WORKDIR = "/api"
  }
  tags = [IMAGE_TAG]
  platforms = ["linux/amd64"]
}
