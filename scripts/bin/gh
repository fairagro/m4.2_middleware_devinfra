#!/usr/bin/env bash
# PATH wrapper: prompt/load GH_TOKEN, then exec real gh.
set -euo pipefail
_gh_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_gh_self="${_gh_dir}/$(basename "${BASH_SOURCE[0]}")"
# shellcheck source=scripts/dev-tokens.sh
source "${_gh_dir}/../dev-tokens.sh"
export GH_TOKEN="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
if [ -z "${GH_TOKEN}" ]; then
  echo "gh: no GH_TOKEN — run: source ./scripts/set-dev-tokens.sh (or open a terminal if never asked)" >&2
  exit 1
fi

REAL_GH=""
candidate="$(command -v -p gh 2>/dev/null || true)"
if [[ -n "${candidate}" && ! "${candidate}" -ef "${_gh_self}" ]]; then
  REAL_GH="${candidate}"
fi
if [[ -z "${REAL_GH}" ]]; then
  for g in /usr/bin/gh /usr/local/bin/gh /bin/gh; do
    if [[ -x "${g}" && ! "${g}" -ef "${_gh_self}" ]]; then
      REAL_GH="${g}"
      break
    fi
  done
fi
if [[ -z "${REAL_GH}" || ! -x "${REAL_GH}" ]]; then
  echo "gh wrapper: could not find real gh binary" >&2
  exit 127
fi
unset _gh_dir _gh_self
exec "${REAL_GH}" "$@"
