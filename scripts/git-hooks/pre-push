#!/usr/bin/env bash
# Combined pre-push hook: Git LFS, then shared pre-commit pre-push stage.
# This file is version-controlled and should be installed via scripts/setup-git-lfs.sh
#
# Environment: host or Dev Container (needs git-lfs + uv/pre-commit for the quality stage).

set -euo pipefail

command -v git-lfs >/dev/null 2>&1 || {
  echo >&2 ""
  echo >&2 "This repository is configured for Git LFS but 'git-lfs' was not found on your PATH."
  echo >&2 "Install Git LFS: https://git-lfs.com (Dev Container images usually include it)."
  echo >&2 "If you no longer wish to use Git LFS, remove this hook by deleting '.git/hooks/pre-push'."
  echo >&2 ""
  exit 2
}
git lfs pre-push "$@"

# Resolve repo root (hooks run with cwd = worktree root for normal pushes).
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "${repo_root}"

ARGS=(hook-impl --config=.pre-commit-config.yaml --hook-type=pre-push)
HERE="$(cd "$(dirname "$0")" && pwd)"
ARGS+=(--hook-dir "${HERE}" -- "$@")

if command -v uv >/dev/null 2>&1 && [[ -f "${repo_root}/pyproject.toml" ]]; then
  exec uv run pre-commit "${ARGS[@]}"
fi

if [[ -x "${repo_root}/.venv/bin/python" ]]; then
  exec "${repo_root}/.venv/bin/python" -m pre_commit "${ARGS[@]}"
fi

if command -v pre-commit >/dev/null 2>&1; then
  exec pre-commit "${ARGS[@]}"
fi

echo >&2 "pre-commit not found. Run: uv sync && ensure 'uv' is on PATH (or activate .venv)."
exit 1
