{
  "venvPath": ".",
  "venv": ".venv",
  "stubPath": "stubs",
  "extraPaths": ["scripts/ai/src"],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.*",
    "**/.venv",
    "**/venv"
